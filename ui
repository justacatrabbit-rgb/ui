    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundColor3 = primary and C.White or C.Field
    btn.AutoButtonColor = false
    btn.Font = primary and Enum.Font.GothamBlack or Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = primary and C.Void or C.Muted
    btn.TextSize = primary and 13 or 11
    btn.ClipsDescendants = true
    btn.ZIndex = 8
    btn.Parent = holder
    corner(btn, 10)

    local s = stroke(btn, primary and C.White or C.Line, 1, primary and 1 or 0)

    local function restSize()
        return UDim2.new(1, 0, 1, 0)
    end

    btn.MouseEnter:Connect(function()
        tween(btn, 0.2, {
            Size = UDim2.new(1, 4, 1, 3),
            BackgroundColor3 = primary and Color3.fromRGB(226, 226, 226) or C.Raised,
            TextColor3 = primary and C.Void or C.Text,
        }, SMOOTH)
        if not primary then
            tween(s, 0.2, {Color = C.White, Transparency = 0.4})
        end
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.24, {
            Size = restSize(),
            BackgroundColor3 = primary and C.White or C.Field,
            TextColor3 = primary and C.Void or C.Muted,
        }, SMOOTH)
        if not primary then
            tween(s, 0.24, {Color = C.Line, Transparency = 0})
        end
    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, 0.09, {
            Size = UDim2.new(1, -8, 1, -5),
            BackgroundColor3 = primary and Color3.fromRGB(196, 196, 196) or C.Ghost,
        }, SMOOTH)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, 0.26, {Size = UDim2.new(1, 4, 1, 3)}, SPRING)
    end)

    reveal(btn)
    return btn, s, holder
end


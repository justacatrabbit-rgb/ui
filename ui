-- Three tries with backoff. A single transient failure here used to kill the
-- whole script with nothing on screen.
local Junkie
local sdkError = "unknown"

for attempt = 1, 3 do
    local url = "https://jnkie.com/sdk/library.lua"
    if attempt > 1 then
        -- Some executors cache HttpGet responses, including failed ones
        url = url .. "?r=" .. tostring(math.random(100000, 999999))
    end

    local fetchOk, body = pcall(function()
        return game:HttpGet(url)
    end)

    if not fetchOk then
        sdkError = "request failed: " .. tostring(body)
    elseif type(body) ~= "string" or body == "" then
        sdkError = "empty response"
    else
        local chunk, compileErr = loadstring(body)
        if not chunk then
            sdkError = "not valid Lua: " .. tostring(compileErr)
            warn("[LunarHub] SDK response began: " .. string.sub(body, 1, 140))
        else
            local runOk, result = pcall(chunk)
            if not runOk then
                sdkError = "SDK errored on load: " .. tostring(result)
            elseif type(result) ~= "table" then
                sdkError = "SDK returned a " .. type(result) .. ", expected a table"
            else
                Junkie = result
                break
            end
        end
    end

    warn("[LunarHub] SDK attempt " .. attempt .. "/3 failed - " .. sdkError)
    if attempt < 3 then
        task.wait(attempt)
    end
end

if not Junkie then
    fatal("Could not reach the JNKIE key server", sdkError
        .. "\nCheck your internet, then try again in a minute. If this keeps up, jnkie.com may be down or rate limiting you.")
    return
end


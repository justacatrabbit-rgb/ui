--=====================================================================
-- HELPERS
--=====================================================================
local function corner(inst, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = inst
    return c
end

local function stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or C.Line
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function gradient(inst, from, to, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(from, to)
    g.Rotation = rotation or 0
    g.Parent = inst
    return g
end

local function tween(inst, duration, props, style, direction)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(duration, style or SMOOTH, direction or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function frame(parent, props)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = C.Card
    f.BorderSizePixel = 0
    for k, v in pairs(props) do
        f[k] = v
    end
    f.Parent = parent
    return f
end

local function label(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.TextColor3 = C.Text
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    for k, v in pairs(props) do
        l[k] = v
    end
    l.Parent = parent
    return l
end

-- Staggered entrance. Each element is hidden, then faded back to whatever
-- transparency it was authored with, a couple of frames after the last one.
local revealStep = 0

local function reveal(inst)
    revealStep = revealStep + 1
    local wait = 0.14 + revealStep * 0.018
    local restore = {}

    if inst:IsA("UIStroke") then
        restore.Transparency = inst.Transparency
        inst.Transparency = 1
    else
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            restore.TextTransparency = inst.TextTransparency
            inst.TextTransparency = 1
        end
        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
            restore.ImageTransparency = inst.ImageTransparency
            inst.ImageTransparency = 1
        end
        if inst.BackgroundTransparency < 1 then
            restore.BackgroundTransparency = inst.BackgroundTransparency
            inst.BackgroundTransparency = 1
        end
    end

    task.delay(wait, function()
        if inst.Parent then
            tween(inst, 0.4, restore, SMOOTH)
        end
    end)

    return inst
end


-- Crescent is two circles: a white disc with a background-coloured disc
-- laid over it and pushed right, leaving a sliver. The L sits in the gap.
local function drawMoon(parent, size, bg, zIndex)
    local holder = frame(parent, {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        ZIndex = zIndex,
    })

    local uploaded = false

    if CONFIG.LOGO_ASSET ~= "" then
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromScale(1, 1)
        img.ScaleType = Enum.ScaleType.Fit
        img.Image = CONFIG.LOGO_ASSET
        img.ZIndex = zIndex + 1
        img.Parent = holder
        uploaded = true
    else
        for _, path in ipairs(CONFIG.LOGO_FILES) do
            local ok, exists = pcall(function() return isfile(path) end)
            if ok and exists then
                local asset
                local gotIt = pcall(function() asset = getcustomasset(path) end)
                if gotIt and asset and asset ~= "" then
                    local img = Instance.new("ImageLabel")
                    img.BackgroundTransparency = 1
                    img.Size = UDim2.fromScale(1, 1)
                    img.ScaleType = Enum.ScaleType.Fit
                    img.Image = asset
                    img.ZIndex = zIndex + 1
                    img.Parent = holder
                    uploaded = true
                    break
                end
            end
        end
    end

    if uploaded then
        return holder
    end

    local disc = frame(holder, {
        BackgroundColor3 = C.White,
        Size = UDim2.fromScale(1, 1),
        ZIndex = zIndex + 1,
    })
    corner(disc, math.floor(size / 2))

    local bite = frame(holder, {
        BackgroundColor3 = bg,
        Position = UDim2.fromOffset(math.floor(size * 0.28), math.floor(size * 0.09)),
        Size = UDim2.fromOffset(math.floor(size * 0.82), math.floor(size * 0.82)),
        ZIndex = zIndex + 2,
    })
    corner(bite, math.floor(size * 0.41))

    label(holder, {
        Position = UDim2.fromOffset(math.floor(size * 0.30), 0),
        Size = UDim2.new(1, -math.floor(size * 0.30), 1, 0),
        Font = Enum.Font.Garamond,
        Text = "L",
        TextColor3 = C.White,
        TextSize = math.floor(size * 0.72),
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = zIndex + 3,
    })

    return holder
end


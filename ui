local function copyToClipboard(text)
    if setclipboard then
        return (pcall(setclipboard, text))
    elseif toclipboard then
        return (pcall(toclipboard, text))
    end
    return false
end

local function handOverLink(url)
    print("[LunarHub] key link: " .. url)

    -- Roblox's in-app browser. Not present in every environment, so the
    -- clipboard is the fallback and the input box is the last resort.
    local opened = pcall(function()
        GuiService:OpenBrowserWindow(url)
    end)
    local copied = copyToClipboard(url)

    if opened then
        setStatus("Opened in your browser", "ok", "LINK SENT")
    elseif copied then
        setStatus("Link copied - paste it in a browser", "ok", "LINK COPIED")
    else
        KeyInput.Text = url
        setStatus("No clipboard here - link is in the box", "idle", "LINK SHOWN")
    end
end


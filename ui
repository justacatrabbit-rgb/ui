-- No colour to lean on, so states differ by shape: idle and busy are a
-- dim filled dot, success is a solid white dot, failure is a hollow ring.
local function setStatus(message, state, pillOverride)
    StatusText.Text = message

    if state == "ok" then
        StatusText.TextColor3 = C.Text
        tween(StatusDot, 0.2, {BackgroundColor3 = C.White, BackgroundTransparency = 0})
        tween(StatusRing, 0.2, {Transparency = 1})
        PillText.Text = pillOverride or "AUTHENTICATED"
        PillText.TextColor3 = C.Text
        tween(PillDot, 0.2, {BackgroundColor3 = C.White})
        tween(PillRing, 0.2, {Transparency = 1})
    elseif state == "bad" then
        StatusText.TextColor3 = C.Text
        tween(StatusDot, 0.2, {BackgroundTransparency = 1})
        tween(StatusRing, 0.2, {Transparency = 0})
        PillText.Text = pillOverride or "REJECTED"
        PillText.TextColor3 = C.Muted
        tween(PillDot, 0.2, {BackgroundTransparency = 1})
        tween(PillRing, 0.2, {Transparency = 0})
    else
        StatusText.TextColor3 = C.Dim
        tween(StatusDot, 0.2, {BackgroundColor3 = C.Muted, BackgroundTransparency = 0})
        tween(StatusRing, 0.2, {Transparency = 1})
        PillText.Text = pillOverride or "AWAITING KEY"
        PillText.TextColor3 = C.Dim
        tween(PillDot, 0.2, {BackgroundColor3 = C.Dim, BackgroundTransparency = 0})
        tween(PillRing, 0.2, {Transparency = 1})
    end
end

-- https://docs.jnkie.com/roblox-sdk/inline-ui
local REASONS = {
    KEY_INVALID = "That key does not exist",
    KEY_EXPIRED = "Key expired - grab a fresh one",
    KEY_INVALIDATED = "This key was disabled",
    -- The Free Key provider issues one-time-use keys, so this fires whenever a
    -- key is validated twice, including re-testing the same key yourself.
    ALREADY_USED = "Key already redeemed - generate a new one",
    HWID_BANNED = "This hardware is banned",
    HWID_MISMATCH = "Key is locked to another device",
    SERVICE_NOT_FOUND = "Service missing - check the dashboard",
    SERVICE_MISMATCH = "Key belongs to a different service",
    PREMIUM_REQUIRED = "This script needs a premium key",
    RATE_LIMITED = "Rate limited - wait five minutes",
    ERROR = "Network error - try again",
}

local function explain(raw)
    raw = tostring(raw)
    if REASONS[raw] then
        return REASONS[raw]
    end
    if raw:match("^http %d+") then
        return "Server said " .. raw
    end
    return raw
end

--=====================================================================
-- KEY HANDLING
--=====================================================================
-- Keys copied out of a browser or Discord drag along zero-width and control
-- characters that survive a plain trim and silently break equality.
local function cleanKey(text)
    text = tostring(text or "")
    text = text:gsub("\226\128\139", ""):gsub("\226\128\140", ""):gsub("\239\187\191", "")
    text = text:gsub("[%z\1-\31\127]", "")
    return (text:gsub("^%s*(.-)%s*$", "%1"))
end

local busy = false
local attempts = 0

local function unlock()
    stopSweep()
    VerifyBtn.Text = "VERIFY AND LOAD"
    busy = false
end

local function reject(message, raw)
    warn("[LunarHub] rejected: " .. tostring(raw or message))
    setStatus(message, "bad")
    unlock()

    -- Invert the button for a beat. Without colour this is the loudest
    -- signal available that something went wrong.
    VerifyBtn.BackgroundColor3 = C.Void
    VerifyBtn.TextColor3 = C.White
    tween(VerifyStroke, 0.12, {Transparency = 0})
    task.delay(0.5, function()
        tween(VerifyBtn, 0.4, {BackgroundColor3 = C.White, TextColor3 = C.Void})
        tween(VerifyStroke, 0.4, {Transparency = 1})
    end)

    tween(FieldStroke, 0.1, {Color = C.White, Transparency = 0})
    task.delay(0.6, function()
        tween(FieldStroke, 0.45, {Color = C.Line, Transparency = 0})
    end)

    task.spawn(shake)
end

-- Opens the gate. SCRIPT_KEY is assigned last, on purpose: the while-loop at
-- the bottom is watching it, so setting it earlier would let the Original Code
-- start running underneath a UI that is still on screen.
local function handOff(key)
    setStatus("Key accepted - starting up", "ok")
    VerifyBtn.Text = "LOADING HUB"
    task.wait(0.5)
    closeUI(false)
    task.wait(0.32)
    getgenv().SCRIPT_KEY = key
end

local function verify()
    if busy then return end

    local key = cleanKey(KeyInput.Text)
    if key == "" then
        setStatus("Enter a key first", "idle")
        tween(FieldStroke, 0.12, {Color = C.White, Transparency = 0.2})
        task.delay(0.5, function()
            tween(FieldStroke, 0.4, {Color = C.Line, Transparency = 0})
        end)
        task.spawn(shake)
        return
    end

    if attempts >= CONFIG.MAX_ATTEMPTS then
        setStatus("Too many attempts - rerun the script", "bad", "LOCKED OUT")
        return
    end

    busy = true
    VerifyBtn.Text = "VERIFYING"
    setStatus("Checking with JNKIE", "idle", "VERIFYING")
    startSweep()

    task.spawn(function()
        local answered = false

        -- check_key blocks on HTTP. Without this, a request that never returns
        -- leaves the button reading VERIFYING with no explanation.
        task.delay(CONFIG.REQUEST_TIMEOUT, function()
            if answered then return end
            answered = true
            reject("JNKIE did not respond in time", "TIMEOUT")
        end)

        local ok, result = pcall(function()
            return Junkie.check_key(key)
        end)

        if answered then return end
        answered = true

        if not ok then
            attempts = attempts + 1
            return reject("SDK error - see console", result)
        end

        if type(result) ~= "table" then
            attempts = attempts + 1
            return reject("Unexpected SDK response - see console", tostring(result))
        end

        if not result.valid then
            attempts = attempts + 1
            local raw = tostring(result.error or result.message or "VALIDATION FAILED")
            reject(explain(raw), raw)
            AttemptText.Text = attempts .. " / " .. CONFIG.MAX_ATTEMPTS

            if raw == "HWID_BANNED" then
                task.delay(2.5, function()
                    pcall(function() lp:Kick("Hardware banned") end)
                end)
            end
            return
        end

        stopSweep()
        AttemptText.Text = ""
        handOff(key)
    end)
end


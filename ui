-- Buttons. Each lives in a fixed-size holder so the hover lift and press
-- squash never reflow the list around it.
local function makeButton(order, height, text, primary)
    local holder = frame(Card, {
        LayoutOrder = order,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        ZIndex = 7,
    })

    local btn = Instance.new("TextButton")
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
